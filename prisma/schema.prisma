// Dhereal TeamOS — Phase 1 schema
// Built by Dhereal1

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleKey {
  FOUNDER
  ADMIN
  STAFF
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum WalletProvider {
  TON
}

enum WalletStatus {
  CONNECTED
  DISCONNECTED
}

enum AIInsightType {
  SUMMARY
  STAFF_SCORE
  DAILY_DIGEST
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

model User {
  id         String   @id @default(cuid())
  telegramId BigInt?  @unique
  username   String?
  firstName  String?
  lastName   String?
  photoUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  TeamMember[]
  sessions     Session[]
  tasksCreated Task[]     @relation("TaskCreated")
  tasksAssigned Task[]    @relation("TaskAssigned")
  reports      Report[]
  reportsReviewed Report[] @relation("ReportReviewedBy")
  activity     ActivityLog[]
  wallets      Wallet[]
  aiInsights   AIInsight[]
  teamsCreated Team[] @relation("TeamCreatedBy")
  invitesCreated TeamInvite[]
  invitesUsed    TeamInvite[] @relation("InviteUsedBy")

  notificationPreferences NotificationPreference[]
  notifications          Notification[]

  orgEdgesFrom OrgGraphEdge[] @relation("OrgEdgeFrom")
  orgEdgesTo   OrgGraphEdge[] @relation("OrgEdgeTo")

  productEvents ProductEvent[]
  feedback      Feedback[]
  checkins      DailyCheckin[]
  streaks       HabitStreak[]
  templateInstalls TemplateInstall[] @relation("TemplateInstalledBy")

  memoryEntries OperationalMemoryEntry[]

  approvalsCreated ApprovalRequest[] @relation("ApprovalCreatedBy")
  approvalsDecided ApprovalRequest[] @relation("ApprovalDecidedBy")
  securityEvents   SecurityEvent[]
}

model Team {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  telegramChatId BigInt?

  planTier        PlanTier @default(FREE)
  planStartedAt   DateTime?
  billingProvider String?
  billingCustomerId String?
  billingStatus   String?
  usageWindowStart DateTime @default(now())
  usageTasksCount  Int      @default(0)
  usageReportsCount Int     @default(0)
  usageInvitesCount Int     @default(0)

  createdByUserId String?
  createdBy       User?   @relation("TeamCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    TeamMember[]
  tasks      Task[]
  reports    Report[]
  activity   ActivityLog[]
  aiInsights AIInsight[]
  wallets    Wallet[]
  sessions   Session[]
  invites    TeamInvite[]

  domainEvents DomainEvent[]
  notifications Notification[]
  notificationTemplates NotificationTemplate[]
  notificationPreferences NotificationPreference[]

  insights      OperationalInsight[]
  insightRuns   InsightRun[]
  orgGraphEdges OrgGraphEdge[]
  metricPoints  MetricTimeseriesPoint[]

  appInstalls WorkspaceAppInstall[]

  productEvents ProductEvent[]
  feedback      Feedback[]
  flagOverrides WorkspaceFlagOverride[]
  checkins      DailyCheckin[]
  streaks       HabitStreak[]
  templateInstalls TemplateInstall[]

  memoryEntries OperationalMemoryEntry[]
  snapshots     OperationalSnapshot[]
  warehouseDaily WarehouseEventDaily[]

  securityEvents SecurityEvent[]
  policies       Policy[]
  approvals      ApprovalRequest[]

  @@index([createdByUserId])
  @@index([planTier])
}

model Role {
  id          String  @id @default(cuid())
  key         RoleKey @unique
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members TeamMember[]
}

model TeamMember {
  id       String @id @default(cuid())
  teamId   String
  userId   String
  roleId   String
  title    String?
  isActive Boolean @default(true)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
  @@index([roleId])
}

model Task {
  id           String       @id @default(cuid())
  teamId       String
  createdById  String
  assignedToId String?

  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NORMAL)

  dueAt       DateTime?
  completedAt DateTime?
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team       Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy  User  @relation("TaskCreated", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo User? @relation("TaskAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)

  aiInsights AIInsight[]

  @@index([teamId, status])
  @@index([assignedToId, status])
  @@index([createdById])
  @@index([dueAt])
  @@index([archivedAt])
}

model Report {
  id       String @id @default(cuid())
  teamId   String
  authorId String

  title  String
  body   String
  status ReportStatus @default(DRAFT)

  periodStart DateTime?
  periodEnd   DateTime?

  reviewNotes String?
  reviewedAt  DateTime?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("ReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  aiInsights AIInsight[]

  @@index([teamId, createdAt])
  @@index([authorId, createdAt])
  @@index([reviewedById])
}

model TeamInvite {
  id          String  @id @default(cuid())
  teamId      String
  createdById String
  token       String  @unique
  roleKey     RoleKey @default(STAFF)
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?

  createdAt DateTime @default(now())

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([teamId, expiresAt])
  @@index([createdById, createdAt])
}

model ActivityLog {
  id         String @id @default(cuid())
  teamId     String
  actorId    String?

  action     String
  entityType String?
  entityId   String?
  metadata   Json?

  createdAt DateTime @default(now())

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([actorId, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  teamId     String?
  token      String   @unique

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([teamId])
}

model Wallet {
  id       String        @id @default(cuid())
  provider WalletProvider @default(TON)
  status   WalletStatus   @default(DISCONNECTED)
  address  String?        @unique

  userId String?
  teamId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([teamId])
}

model AIInsight {
  id        String @id @default(cuid())
  teamId    String
  userId    String?
  reportId  String?
  taskId    String?

  type      AIInsightType
  provider  String
  model     String?
  inputHash String?
  content   String

  createdAt DateTime @default(now())

  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([reportId])
  @@index([taskId])
}

// ----------------------------
// Phase 2 foundations
// ----------------------------

enum DomainEventStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

model DomainEvent {
  id            String           @id @default(cuid())
  teamId        String?
  // Namespaced event name, e.g. "teamos.task.created"
  name          String
  // Event schema version for governance/replay
  version       Int              @default(1)
  // Optional schema key (stable identifier) for migrations
  schemaKey     String?
  dedupeKey     String?
  payload       Json
  status        DomainEventStatus @default(PENDING)
  attempts      Int              @default(0)
  lastError     String?
  processedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  team          Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([teamId, createdAt])
  @@index([status, createdAt])
  @@unique([name, teamId, dedupeKey])
}

enum PlatformAppStatus {
  ACTIVE
  INACTIVE
}

model PlatformApp {
  id        String            @id @default(cuid())
  // stable key, e.g. "teamos.core", "crm.core"
  key       String            @unique
  name      String
  status    PlatformAppStatus @default(ACTIVE)
  // SemVer-ish string; governance only
  version   String
  manifest  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installs  WorkspaceAppInstall[]
}

enum InstallStatus {
  ENABLED
  DISABLED
}

model WorkspaceAppInstall {
  id        String        @id @default(cuid())
  teamId    String
  appId     String
  status    InstallStatus @default(ENABLED)
  // app-scoped permission grants (JSON list for Phase 4; can normalize later)
  grants    Json?
  config    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  app  PlatformApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([teamId, appId])
  @@index([teamId, status])
  @@index([appId, status])
}

model PlatformServiceRegistration {
  id        String   @id @default(cuid())
  // service id, e.g. "teamos.core"
  serviceId String
  // semver string for contract governance
  version   String
  // capabilities the service exposes
  capabilities Json
  // optional metadata: owner, repo, etc.
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, version])
  @@index([serviceId])
}

enum WorkflowStatus {
  ACTIVE
  INACTIVE
}

enum WorkflowExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

model Workflow {
  id        String         @id @default(cuid())
  teamId    String
  name      String
  status    WorkflowStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions  WorkflowVersion[]
  executions WorkflowExecution[]

  @@index([teamId, status])
}

model WorkflowVersion {
  id          String   @id @default(cuid())
  workflowId  String
  version     Int
  isCurrent   Boolean  @default(false)
  // JSON graph describing triggers/conditions/actions
  definition  Json

  createdAt DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@unique([workflowId, version])
  @@index([workflowId, isCurrent])
}

model WorkflowExecution {
  id              String                 @id @default(cuid())
  workflowId      String
  workflowVersionId String
  teamId          String
  status          WorkflowExecutionStatus @default(RUNNING)
  triggerEventId  String?
  startedAt       DateTime               @default(now())
  finishedAt      DateTime?
  attempts        Int                    @default(0)
  lastError       String?

  workflow        Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  logs            WorkflowLog[]

  @@index([teamId, startedAt])
  @@index([workflowId, startedAt])
  @@index([status, startedAt])
}

model WorkflowLog {
  id           String            @id @default(cuid())
  executionId  String
  level        String
  message      String
  metadata     Json?
  createdAt    DateTime          @default(now())

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
}

enum NotificationChannel {
  TELEGRAM
  IN_APP
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model NotificationTemplate {
  id        String @id @default(cuid())
  teamId    String?
  key       String
  channel   NotificationChannel
  // JSON payload describing template format, variables, etc.
  definition Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, key, channel])
  @@index([key])
}

model NotificationPreference {
  id        String @id @default(cuid())
  userId    String
  teamId    String?
  channel   NotificationChannel
  enabled   Boolean @default(true)
  // future: quiet hours, batching config, etc.
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId, channel])
  @@index([userId])
  @@index([teamId])
}

model Notification {
  id          String               @id @default(cuid())
  teamId      String
  userId      String?
  channel     NotificationChannel
  priority    NotificationPriority @default(NORMAL)
  status      NotificationStatus   @default(PENDING)
  templateKey String?
  // Rendered payload to deliver; channel-specific
  payload     Json
  dedupeKey   String?
  scheduledAt DateTime?
  sentAt      DateTime?
  attempts    Int                  @default(0)
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([status, scheduledAt])
  @@index([userId, createdAt])
  @@unique([teamId, channel, dedupeKey])
}

// ----------------------------
// Phase 3 foundations
// ----------------------------

enum InsightStatus {
  OPEN
  DISMISSED
  RESOLVED
}

enum InsightSeverity {
  INFO
  WARNING
  CRITICAL
}

model OperationalInsight {
  id            String         @id @default(cuid())
  teamId        String
  // e.g. "bottleneck.blocked_tasks", "risk.missed_reports", "workload.imbalance"
  key           String
  status        InsightStatus  @default(OPEN)
  severity      InsightSeverity @default(INFO)
  score         Int            @default(0) // 0-100
  title         String
  summary       String
  recommendation String?
  evidence      Json?
  dedupeKey     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([teamId, key, createdAt])
  @@index([status, createdAt])
  @@unique([teamId, key, dedupeKey])
}

enum InsightRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model InsightRun {
  id        String          @id @default(cuid())
  teamId    String
  kind      String          // e.g. "daily"
  status    InsightRunStatus @default(RUNNING)
  stats     Json?
  lastError String?
  startedAt DateTime        @default(now())
  finishedAt DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, startedAt])
  @@index([status, startedAt])
}

enum GraphEdgeType {
  REPORTS_TO
  COLLABORATES_WITH
  DELEGATES_TO
  REVIEWS_FOR
}

model OrgGraphEdge {
  id        String        @id @default(cuid())
  teamId    String
  type      GraphEdgeType
  fromUserId String
  toUserId   String
  weight    Int           @default(1)
  lastSeenAt DateTime     @default(now())
  metadata  Json?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fromUser User @relation("OrgEdgeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("OrgEdgeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([teamId, type, fromUserId, toUserId])
  @@index([teamId, type])
  @@index([fromUserId])
  @@index([toUserId])
}

model MetricTimeseriesPoint {
  id        String   @id @default(cuid())
  teamId    String
  key       String   // e.g. "health.reliability", "velocity.tasks_completed_7d"
  ts        DateTime @default(now())
  value     Float
  metadata  Json?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, key, ts])
  @@index([key, ts])
}

// ----------------------------
// Phase 5 foundations
// ----------------------------

model ProductEvent {
  id        String   @id @default(cuid())
  teamId    String?
  userId    String?
  name      String
  metadata  Json?
  createdAt DateTime @default(now())

  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([userId, createdAt])
  @@index([name, createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  teamId    String?
  userId    String?
  kind      String   // e.g. "bug", "feedback"
  message   String
  page      String?
  metadata  Json?
  createdAt DateTime @default(now())

  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([kind, createdAt])
}

model FeatureFlag {
  id           String   @id @default(cuid())
  key          String   @unique
  description  String?
  defaultEnabled Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  overrides WorkspaceFlagOverride[]
}

model WorkspaceFlagOverride {
  id        String  @id @default(cuid())
  teamId    String
  flagId    String
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([teamId, flagId])
  @@index([teamId])
  @@index([flagId])
}

model DailyCheckin {
  id       String @id @default(cuid())
  teamId   String
  userId   String
  dateKey  String // YYYY-MM-DD (UTC)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, dateKey])
  @@index([teamId, dateKey])
  @@index([userId, dateKey])
}

model HabitStreak {
  id        String @id @default(cuid())
  teamId    String
  userId    String
  current   Int    @default(0)
  best      Int    @default(0)
  lastDateKey String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model WorkspaceTemplate {
  id        String @id @default(cuid())
  key       String @unique // e.g. "creator", "agency", "crypto"
  name      String
  description String?
  definition Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installs TemplateInstall[]
}

model TemplateInstall {
  id         String @id @default(cuid())
  teamId     String
  templateId String
  installedById String?
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  template WorkspaceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  installedBy User? @relation("TemplateInstalledBy", fields: [installedById], references: [id], onDelete: SetNull)

  @@unique([teamId, templateId])
  @@index([teamId, createdAt])
}

// ----------------------------
// Phase 6 foundations
// ----------------------------

enum MemoryType {
  NOTE
  DECISION
  PROCEDURE
  INCIDENT
}

model OperationalMemoryEntry {
  id        String     @id @default(cuid())
  teamId    String
  type      MemoryType @default(NOTE)
  title     String
  body      String
  tags      String[]
  pinned    Boolean    @default(false)
  createdById String?
  source    String? // e.g. "miniapp", "telegram"
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([teamId, type, createdAt])
  @@index([pinned, createdAt])
}

model OperationalSnapshot {
  id        String   @id @default(cuid())
  teamId    String
  dateKey   String   // YYYY-MM-DD (UTC)
  // Denormalized JSON: dashboard stats, key risks, etc.
  payload   Json
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, dateKey])
  @@index([teamId, createdAt])
}

model WarehouseEventDaily {
  id        String   @id @default(cuid())
  teamId    String
  dateKey   String // YYYY-MM-DD (UTC)
  // event namespace, e.g. "teamos", "crm"
  namespace String
  eventName String
  count     Int      @default(0)
  // lightweight example payload hashes/ids for debugging (optional)
  sample    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, dateKey, namespace, eventName])
  @@index([teamId, dateKey])
  @@index([namespace, eventName, dateKey])
}

enum GovernanceStatus {
  ACTIVE
  DEPRECATED
}

model EventSchemaRegistry {
  id        String   @id @default(cuid())
  name      String   // "teamos.task.created"
  version   Int
  schemaKey String
  jsonSchema Json
  status    GovernanceStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, version])
  @@index([schemaKey])
}

model ServiceOwnership {
  id        String   @id @default(cuid())
  serviceId String   // e.g. "teamos.core"
  owner     String   // e.g. "platform", "ops", "growth"
  slackChannel String?
  status    GovernanceStatus @default(ACTIVE)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId])
}

// ----------------------------
// Phase 7 foundations
// ----------------------------

enum SecuritySeverity {
  INFO
  WARNING
  CRITICAL
}

model SecurityEvent {
  id        String          @id @default(cuid())
  teamId    String?
  userId    String?
  severity  SecuritySeverity @default(INFO)
  type      String          // e.g. "policy.denied", "session.anomaly", "approval.requested"
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

enum PolicyStatus {
  ACTIVE
  INACTIVE
}

model Policy {
  id        String      @id @default(cuid())
  teamId    String
  key       String      // e.g. "workflow.telegram_notify.requires_approval"
  status    PolicyStatus @default(ACTIVE)
  // JSON policy definition (matchers + effect)
  definition Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, key])
  @@index([teamId, status])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

model ApprovalRequest {
  id        String         @id @default(cuid())
  teamId    String
  createdById String
  status    ApprovalStatus @default(PENDING)
  // What is being approved
  entityType String        // e.g. "WorkflowExecution"
  entityId   String
  actionKey  String        // e.g. "telegram_notify"
  reason     String?
  payload    Json?
  decidedById String?
  decidedAt  DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation("ApprovalCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  decidedBy User? @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([teamId, status, createdAt])
  @@index([entityType, entityId])
}
